{
  "name": "anichat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --host",
    "build": "tsc -p client --noEmit && vite build client",
    "start": "node server/index.js"
  },
  "dependencies": { "express": "^4.19.2", "socket.io": "^4.7.5" },
  "devDependencies": {
    "@types/react": "^18.3.3", "@types/react-dom": "^18.3.0", "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2", "react": "^18.3.1", "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5", "typescript": "^5.5.3", "vite": "^5.4.0"
  }
}
